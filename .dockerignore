# Keeps the build context small and, more to the point, keeps files that never
# reach the image from invalidating the `COPY . .` layer (and so the Next build).
# .git changes on every fetch; .last-built-sha changes after every build.
# Keep in step with is_build_input in update.sh and lib/buildInputs.ts.
# tests/ and *.test.ts stay in: next build type-checks every **/*.ts.
.git
.github
.claude
.next
node_modules
graphify-out
keys
.env*
.last-built-sha
tsconfig.tsbuildinfo
.DS_Store
.gitignore
.gitattributes
update.sh
tests/update_sh_test.sh
/*.md
docs
firmware
ev-dashboard-pi-tunnel-failover
